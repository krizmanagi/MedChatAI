# Which model backend to use: azure | openai | mock | auto
# "auto" uses Azure if both Azure values are set, else OpenAI if a key is set, else mock (demo mode).
LLM_PROVIDER=auto

# --- Azure OpenAI Service (recommended) ---
# Endpoint and key: Azure portal > your Azure OpenAI resource > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# The *deployment name* you gave your GPT-4-family model in Azure AI Foundry
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-06-01

# --- OpenAI API (alternative) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# --- Tuning ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30
MAX_MESSAGE_CHARS=2000
MAX_HISTORY_TURNS=6
REDACT_PII=true
# Comma-separated list; use your site's origin in production
ALLOWED_ORIGINS=*
